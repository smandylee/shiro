# Copy to .env and fill in. Run with:  npx tsx --env-file=.env src/index.ts
# On a server, put the same lines in the systemd EnvironmentFile instead.
# Everything marked (optional) can be left out; that feature just stays off.

# --- Required -----------------------------------------------------------------

# Discord: https://discord.com/developers/applications  ->  Bot  ->  Reset Token.
# Turn on the "Message Content Intent" for the bot on that same page.
DISCORD_BOT_TOKEN=
# Your own Discord user id (Settings -> Advanced -> Developer Mode, then right-click yourself -> Copy User ID).
# Without it the bot refuses to start. Only this account gets the personal-data tools.
DISCORD_OWNER_USER_ID=

# Gemini on Vertex AI. Authenticate with a service account key file
# (role: Vertex AI User) or with `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_LOCATION=global        # (optional) where the chat model is called
# EMBEDDING_LOCATION=asia-east2       # (optional) a regional endpoint is faster for embeddings

# --- Long-term memory (optional) ----------------------------------------------
# Without it she only remembers recent turns. The index "shiro-memory" is created for you.
PINECONE_API_KEY=

# --- The avatar bridge (optional) ---------------------------------------------
# The WebSocket the avatar, the dev worker and the Minecraft bot connect to.
# It does not start unless a token is set. Use a long random string.
AVATAR_BRIDGE_TOKEN=
# Bind to localhost, or to a private-network address (Tailscale / WireGuard).
# Never expose it to the public internet.
# AVATAR_BRIDGE_HOST=127.0.0.1
# AVATAR_BRIDGE_PORT=18790

# --- Voice (optional) ---------------------------------------------------------
# TTS_PROVIDER=elevenlabs             # "typecast" (default) or "elevenlabs"
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4          # eleven_v4_turbo starts speaking faster
# TYPECAST_API_KEY=
# TYPECAST_VOICE_ID=
# Voice is only synthesised while an avatar is connected, so an idle bot costs nothing.

# --- Google account: Gmail, Calendar, Drive notes (optional) -------------------
# See docs/google-integration.md. These files are created by `npm run google:authorize`.
# GOOGLE_OAUTH_CLIENT_PATH=~/.openclaw/secrets/google-oauth-client.json
# GOOGLE_OAUTH_TOKEN_PATH=~/.openclaw/secrets/google-oauth-token.json

# --- Other integrations (optional) --------------------------------------------
# A Canvas LMS calendar feed (.ics URL): deadline reminders.
# CANVAS_ICS_URL=
# An OpenClaw gateway (https://docs.openclaw.ai) that runs shell commands you approved in chat.
# Without it she cannot run commands. Its OpenAI-compatible chat endpoint is off by default; enabling it,
# the token, and where the commands run are explained in docs/command-execution.md. The token is
# full operator access to the gateway: keep the gateway on localhost or a private network.
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=

# --- Behaviour (optional) -----------------------------------------------------
# SHIRO_TZ=Asia/Hong_Kong             # timezone for the briefing, quiet hours and nightly jobs
# SHIRO_BRIEFING_HOUR=8               # morning briefing, local hour
# SHIRO_BRIEFING_LATEST_HOUR=12       # a late briefing is still sent until this hour
# SHIRO_QUIET_START=23                # to-do nudges stay silent from this hour ...
# SHIRO_QUIET_END=8                   # ... until this one
# SHIRO_CHATTER_IDLE_MIN=30           # she never starts a conversation sooner than this after you last wrote
# SHIRO_WONDER_GAP_MIN=30             # minimum gap between questions she thinks up on her own
# SHIRO_PROFILE_HOUR=4                # nightly profile learning
# SHIRO_MOOD_HOUR=4                   # nightly reflection that sets tomorrow's leftover feeling
